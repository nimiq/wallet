    "@nimiq/hub-api": "^1.17.0",
    "@nimiq/iqons": "^1.5.2",
    "@nimiq/libswap": "^1.5.2",
    "@nimiq/oasis-api": "^1.1.1",
    "@nimiq/oasis-bank-list": "https://github.com/nimiq/oasis-bank-list#main",
    "@nimiq/rpc": "^0.4.1",
    "@nimiq/style": "^0.8.2",
    "@nimiq/ten31-pass-api": "^1.1.0",
    "@nimiq/utils": "^0.12.1",
    "@nimiq/vue-components": "https://github.com/nimiq/vue-components#build/albatross",
    "@sentry/vue": "^11.14.0",
    "@unstoppabledomains/resolution": "^9.3.3",
    "bitcoinjs-lib": "^5.2.0",
    "chart.js": "^4.6.1",
    "ethers": "^5.7.2",
