{
  "name": "@nimiq/wallet",
  "version": "0.1.0",
  "private": false,
  "author": "Nimiq (https://www.nimiq.com)",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "serve": "yarn i18n:extract && vp dev",
    "build": "yarn i18n:extract && yarn verify && vp build",
    "build:ci": "yarn i18n:extract && yarn verify && build=testnet vp build",
    "preview": "vp preview",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vue-tsc.json && vue-tsc --noEmit -p tsconfig.node.json",
    "verify": "NODE_ENV=production vp check && yarn typecheck",
    "i18n:extract": "node ./node_modules/webpack-i18n-tools/index.js ./src/i18n/en.po",
    "i18n:pull": "tx pull -l es,zh,de,fr,nl,pt,ru,uk --force --minimum-perc 50",
    "i18n:push": "tx push --source",
    "i18n:sync": "yarn i18n:extract && yarn i18n:push; yarn i18n:pull",
    "release": "./scripts/deploy.sh",
    "test": "vp test run",
    "utils:getBankList": "oasis-bank-list-update",
    "utils:makeNginxAllowlist": "node ./scripts/makeNginxAllowlist.js"
  },
  "main": "src/main.ts",
  "dependencies": {
    "@formatjs/intl-displaynames": "^8.0.3",
    "@linusborg/vue-simple-portal": "^0.1.4",
    "@nimiq/core": "^2.23.0",
    "@nimiq/electrum-client": "https://github.com/nimiq/electrum-client#build",
    "@nimiq/fastspot-api": "^1.10.3",
    "@nimiq/gasless-sdk": "^0.2.0",
    "@nimiq/hub-api": "^1.17.0",
    "@nimiq/iqons": "^1.6.0",
    "@nimiq/libswap": "^1.5.2",
    "@nimiq/oasis-api": "^1.1.1",
    "@nimiq/oasis-bank-list": "https://github.com/nimiq/oasis-bank-list#main",
    "@nimiq/rpc": "^0.4.1",
    "@nimiq/style": "^0.8.2",
    "@nimiq/ten31-pass-api": "^1.1.0",
    "@nimiq/utils": "^0.12.4",
    "@sentry/vue": "^11.14.0",
    "@unstoppabledomains/resolution": "^9.3.3",
    "bitcoinjs-lib": "^7.0.5",
    "chart.js": "^4.6.1",
    "ethers": "^5.8.0",
    "iban": "^0.0.14",
    "idb-keyval": "^6.3.0",
    "input-format": "^0.2.8",
    "js-sha3": "^0.8.0",
    "markdown-it": "^12.3.2",
    "markdown-it-abbr": "^1.0.4",
    "markdown-it-deflist": "^2.1.0",
    "markdown-it-emoji": "^2.0.2",
    "markdown-it-footnote": "^3.0.3",
    "markdown-it-ins": "^3.0.1",
    "markdown-it-mark": "^3.0.1",
    "markdown-it-sub": "^1.0.0",
    "markdown-it-sup": "^1.0.0",
    "pinia": "^2.3.1",
    "promise.allsettled": "^1.0.7",
    "qr-creator": "^1.0.0",
    "qr-scanner": "^1.4.2",
    "register-service-worker": "^1.7.0",
    "safari-14-idb-fix": "^3.0.0",
    "sturdy-websocket": "^0.2.1",
    "viem": "^2.58.0",
    "vue": "^2.7.16",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^8.28.2",
    "vue-matomo": "^4.2.0",
    "vue-router": "^3.6.5",
    "vue-virtual-scroller": "https://github.com/sisou/vue-virtual-scroller#nimiq/build",
    "webpack-i18n-tools": "https://github.com/nimiq/webpack-i18n-tools"
  },
  "devDependencies": {
    "@types/iban": "^0.0.35",
    "@types/markdown-it": "^12.2.3",
    "@types/node": "^22",
    "@types/promise.allsettled": "^1.0.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue2": "^2.3.4",
    "@vue/compiler-dom": "^3.5.45",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-import": "^2.32.0",
    "path-to-regexp": "^6.3.0",
    "process": "^0.11.10",
    "readable-stream": "^4.8.0",
    "sass": "^1.108.2",
    "typescript": "~5.9.3",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-wasm": "^3.6.0",
    "vite-plus": "^1.8.0",
    "vue-tsc": "^2.2.12",
    "workbox-build": "^7.4.1"
  },
  "license": "Apache-2.0",
  "resolutions": {
